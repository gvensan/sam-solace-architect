# ============================================================================
# Solace Architect V2 monorepo — root .gitignore
# ============================================================================
# This repo tracks: documents/, solace-architect-core/, test-harness/,
# tests/, plus top-level config (.github/, README.md, pytest.ini).
#
# It does NOT track:
#   - plugins/   — separate git repo (sam-solace-architect-agents) for contributing to
#                  solacecommunity/solace-agent-mesh-plugins
#   - sam/       — SAM runtime workspace (SQLite state, logs, generated configs)
#   - .venv/     — Python virtual environment
#   - .env       — local secrets

# ============================================================================
# Separate repos / runtime workspaces
# ============================================================================
plugins/
sam/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
*.whl
*.tar.gz
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# Editable installs (pip)
*.egg-link
.eggs/

# ============================================================================
# Testing & coverage
# ============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.cache/
nosetests.xml

# Type-checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ============================================================================
# Virtual environments
# ============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ============================================================================
# Secrets & local config
# ============================================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================================
# Runtime state (logs, SQLite, generated artifacts)
# ============================================================================
*.log
logs/
**/logs/

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Engagement artifacts produced by sam run / pytest fixtures
artifacts/
test-harness/artifacts/
test-harness/exports/
test-harness/projects/

# ============================================================================
# Editors & OS
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================================
# Jupyter
# ============================================================================
.ipynb_checkpoints/
