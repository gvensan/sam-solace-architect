# Solace Architect V2 — environment variables
# Copy to .env at the repo root and fill in your values.
#
# Solace Architect plugins do MESSAGING ONLY (publish/subscribe on the broker).
# We never call SEMP, never create VPNs / queues / ACL profiles. The broker
# credentials below are a client username — not an admin user. Broker admin
# operations stay in your IaC / Mission Control / admin-UI workflow.

# ────────────────────────────────────────────────────────────────────────────
# SAM core
# ────────────────────────────────────────────────────────────────────────────

# A2A namespace — REQUIRED; no default. Misconfig fails loud at startup.
NAMESPACE=sa-dev

# Broker connection. Use ws:// (WebSocket) for SAM's default transport.
SOLACE_BROKER_URL=ws://localhost:8008
SOLACE_BROKER_VPN=default

# Client username with publish/subscribe rights — NOT an admin user.
# On the standard Solace dev container, "default" works out of the box.
SOLACE_BROKER_USERNAME=default
SOLACE_BROKER_PASSWORD=default

# dev_mode=true skips TLS verification and a few production-only checks.
# Safe for local Docker brokers; leave false for any non-local broker.
SOLACE_DEV_MODE=true

# ────────────────────────────────────────────────────────────────────────────
# LLM (LiteLLM via SAM/ADK)
# ────────────────────────────────────────────────────────────────────────────
# Model identifier in LiteLLM provider-prefixed format:
#   anthropic/<model>    (e.g., anthropic/claude-sonnet-4-20250514)
#   openai/<model>       (e.g., openai/gpt-4o)
#   gemini/<model>       (e.g., gemini/gemini-1.5-pro)
#   bedrock/<model>      (uses AWS_* env vars)
#   azure/<deployment>   (uses LLM_SERVICE_ENDPOINT for Azure endpoint)
#   ollama/<model>       (local; LLM_SERVICE_ENDPOINT=http://localhost:11434)
#   vertex_ai/<model>    (uses GCP creds)
# Or a custom alias when routing through a LiteLLM proxy.
LLM_SERVICE_GENERAL_MODEL_NAME=anthropic/claude-sonnet-4-20250514

# Leave blank for cloud providers' default endpoints.
# Set when using a LiteLLM proxy, Azure, Ollama, or any self-hosted LLM.
LLM_SERVICE_ENDPOINT=

# Your provider API key (or LiteLLM-proxy key).
LLM_SERVICE_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# WebUI entrypoint
# ────────────────────────────────────────────────────────────────────────────
WEBUI_PORT=8080                # change if 8080 conflicts (e.g., broker admin UI)
# WEBUI_HOST=0.0.0.0
# WEBUI_ENTRYPOINT_ID=sa-webui-ep-01

AUTH_TYPE=none                 # none | oidc — Phase 1 default
# OIDC_ISSUER=
# OIDC_CLIENT_ID=

# ────────────────────────────────────────────────────────────────────────────
# Artifact storage
# ────────────────────────────────────────────────────────────────────────────
# Where engagement artifacts are persisted. Default is /tmp/sam-solace-architect.
# SA_STORAGE_ROOT=/tmp/sam-solace-architect

# ────────────────────────────────────────────────────────────────────────────
# Event Portal provisioning (OPT-IN — only when installing solace-architect-provisioning)
# ────────────────────────────────────────────────────────────────────────────
# This is the Solace Cloud REST API (Event Portal management), NOT broker SEMP.
# Requires EP Designer MCP installed in the SAM runtime.
# SOLACE_API_TOKEN=             # must have "Designer Read+Write" scope
# SOLACE_API_BASE_URL=https://api.solace.cloud   # region: US default; EU/AU/SG variants exist

# ────────────────────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
